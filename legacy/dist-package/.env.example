# LLM Provider Configuration
# This app supports multiple LLM providers through OpenAI-compatible APIs

# Required - Your LLM API key
# For OpenAI: Get from https://platform.openai.com/api-keys
# For Anthropic: Get from https://console.anthropic.com/
# For Azure: Use your Azure OpenAI key
LLM_API_KEY=your-api-key-here

# Optional - Provider type (default: 'openai')
# Options: 'openai', 'anthropic', 'azure', 'custom'
LLM_PROVIDER=openai

# Optional - Model name (default: 'MiniMax-M2.1-lightning')
# Examples: 'MiniMax-M2.1-lightning', 'gpt-4', 'gpt-4o', 'claude-3-sonnet-20240229'
LLM_MODEL=MiniMax-M2.5

# Optional - Custom base URL for self-hosted models
# Default for OpenAI: https://api.openai.com/v1
# For Anthropic: https://api.anthropic.com/v1
# For Azure: Your Azure endpoint URL
# LLM_BASE_URL=https://api.openai.com/v1

# Legacy support (optional)
# The app also accepts GEMINI_API_KEY or API_KEY for backward compatibility
# GEMINI_API_KEY=your-key
# API_KEY=your-key

# Azure OpenAI specific (only needed if using Azure)
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com

# Supabase Configuration (optional)
# SUPABASE_URL=your-supabase-url
# SUPABASE_ANON_KEY=your-supabase-anon-key
